{
  "manifest_version": 2,
  "id": "khiqwq.owner_auth_plugin",
  "version": "2.2.0",
  "name": "用户身份验证插件",
  "description": "通过 QQ 号精确验证特殊用户身份，按消息号向 Planner 传递可信身份与规划便签，并向 Replyer 注入独立回复便签。支持多个用户、群聊范围和 Identity Only 模式。",
  "author": {
    "name": "风花叶",
    "url": "https://github.com/khiqwq"
  },
  "license": "GPL-3.0-or-later",
  "urls": {
    "repository": "https://github.com/khiqwq/owner_auth_plugin",
    "homepage": "https://github.com/khiqwq/owner_auth_plugin",
    "issues": "https://github.com/khiqwq/owner_auth_plugin/issues"
  },
  "host_application": {
    "min_version": "1.0.0",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.0.0",
    "max_version": "2.99.99"
  },
  "dependencies": [],
  "capabilities": [
    "message.get_by_id",
    "config.get",
    "send.text"
  ],
  "plugin_type": "extension",
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  }
}
